    padding: 32px 24px;
    block-size: 100%;
  }
}
.gemini-card-centered.gemini-theme-light-blue {
  --gemini-card-description-color: var(--gemini-color-grey-100);
  --gemini-card-arrow-color: var(--gemini-color-white);
