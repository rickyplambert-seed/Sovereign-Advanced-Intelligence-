  --geminin-case-preview-copy-color: var(--gemini-color-grey-600);                                                                                                                                        }
.gemini-case-study-preview:hover .gemini-preview-thumbnail {
  transform: scale(0.98, 0.975);                                                                                                                                                                            transition-duration: 0.3s;
}
