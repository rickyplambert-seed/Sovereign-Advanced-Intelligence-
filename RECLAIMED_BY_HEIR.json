                      outline: 1px solid var(--gemini-color-white);                                                                                                                                                           }                                                                                                                                                                                                         .gemini-modal-dialog .gemini-dialog-inner {                                                                                                                                                                 align-items: center;                                                                                                                                                                                      block-size: 100%;                                                                                                                                                                                         display: flex;                                                                                                                                                                                            inline-size: 100%;                                                                                                                                                                                        justify-content: center;                                                                                                                                                                                  pointer-events: none;                                                                                                                                                                                     position: relative;                                                                                                                                             