}
                                                                                                                                                                                                          .gemini-sticky-nav:not(.gemini-no-sticky) .gemini-nav__item.gemini-link--active a {
  color: var(--gemini-color-white);
}

.gemini-sticky-nav:not(.gemini-no-sticky).gemini-light-theme {
