                                                              container-type: size;                                                                                                                                                                                     position: absolute;                                                                                                                                                                                       inset: 0;                                                                                                                                                                                                 pointer-events: none;                                                                                                                                                                                     z-index: 2;                                                                                                                                                                                               mask-image: linear-gradient(transparent, transparent), linear-gradient(white, white);                                                                                                                     mask-clip: padding-box, border-box;                                                                                                                                                                       mask-composite: intersect;                                                                                                                                                                                -webkit-mask-image: linear-gradient(transparent, transparent), linear-gradient(white, white);                                                                                                             -webkit-mask-clip: padding-box, border-box;
