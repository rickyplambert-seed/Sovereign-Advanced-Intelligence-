import os
import pygit2

def auto_commit_changes(repo_path, commit_message="Automated local environment backup"):
    # 1. Open or init the repository
    if not os.path.exists(os.path.join(repo_path, '.git')):
        print(f"Initializing new Git repository at {repo_path}...")
        repo = pygit2.init_repository(repo_path)
    else:
        repo = pygit2.Repository(repo_path)

    # 2. Check repository status
    status = repo.status()
    if not status:
        print("No changes detected. Everything is up to date.")
        return

    # 3. Stage changes
    index = repo.index
    index.add_all()
    index.write()
    tree_id = index.write_tree()

    # 4. Set identity profiles
    author = pygit2.Signature('James Anthony Lambert', 'james@geminiinclllc.local')
    committer = author

    # 5. Handle parent commits safely
    parents = []
    if not repo.is_empty:
        parents.append(repo.head.target)

    # 6. Commit
    commit_id = repo.create_commit('HEAD', author, committer, commit_message, tree_id, parents)
    print(f"Successfully committed changes! Commit ID: {commit_id}")

# Run the function on the current working directory
