      const id = best.id;
      if (id === currentId) return;
      currentId = id;

      const target = '#' + (linkMap[id] || id);
      navLinks.forEach((l) => {
        if (l.getAttribute('href') === target) l.classList.add('active');
        else l.classList.remove('active');
      });
