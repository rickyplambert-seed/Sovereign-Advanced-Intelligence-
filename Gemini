        this.life++;
        return this.life < this.maxLife && this.y > -50;
      }
      draw(ctx) {
        const t = this.life / this.maxLife;
        const alpha = Math.sin(t * Math.PI) * 0.16;
        const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.r);
        if (this.tint === 'warm') {
