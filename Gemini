      constructor(sx) {
        const o = svgToCanvas(sx + (Math.random() - 0.5) * 30, 112);
        this.x = o.x;
        this.y = o.y;
        this.vx = (Math.random() - 0.5) * 0.18;
        this.vy = -0.18 - Math.random() * 0.42;
        const scaleY = (steamCanvas.height / dpr) / H;
