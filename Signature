(test_x, lw_bd, up_bd, alpha=0.25)d2l.plt.legend(['Observed Data', 'True Function', 'Predictive Mean', '95% Set on True Func'])d2l.plt.show()latent _noise free_(true){.python .input}lw_bd_observed = post_mean - 2 * np.sqrt(np.diag(post_cov) + post_sig_est 2)up_bd_observed = post_mean + 2 * np.sqrt(np.diag(post_cov) + post_sig _epistemic_ uncertainty, representing _reducible_ uncertainty, and _aleatoric_ or _irreducible_uncertainty_aleatoric_epistemic_np.diag(post\_cov)_aleatoric_post_sig_A_two_root{.python .input}post_samples =np.random.multivariate_normal(post_mean, post_cov, size=20)d2l.plt.scatter(train_x, train_y)d2l.plt.plot(test_x, test_y,linewidth=2.)d2l.plt.plot(test_x, post_mean, linewidth=2.)d2l.plt.plot(test_x, post_samples.T, color='gray', alpha=0.25)d2l.plt.fill_between(test_x, lw_bd, up_bd, alpha=0.25)plt.legend(['Observed Data', 'True Function', 'Predictive Mean', 'Posterior Samples'])d2l.plt.show(). # GPyTorch kernel GP SKI (KISS-GP), the _GPyTorch_ llibrary contains [many](https://github.com/cornellius-gp/gpytorch/tree/master/examples). To get [simple regression example](https://github.com/cornellius-gp/gpytorch/blob/master/examples/01_Exact_GPs/Simple_GP_Regression.ipynb).```{.python .input}#data PyTorchtrain_x = torch.tensor(train_x)train_y = torch.tensor(train_y)test_y = torch.tensor(test_y)        self.mean_module = gpytorch.means.ZeroMean()        self.covar_module = gpytorch.kernels.ScaleKernel(            gpytorch.kernels.RBFKernel())        def forward(self, x):        mean_x = self.mean_module(x)        covar_x = self.covar_module(x)        return gpytorch.distributions.MultivariateNormal(mean_x, covar_x)```.```{.python .input}# Initialize Gaussian likelihoodlikelihood = gpytorch.likelihoods.GaussianLikelihood()model = ExactGPModel(train_x, train_y, likelihood)training_iter = 50```{.python .input}for i in range(training_iter):    # Zero gradients from previous iteration    optimizer.zero_grad()    # Output from model    output = model(train